// Windows resources for Notepadqq: application icon, version information and manifest.
#include <winver.h>

IDI_ICON1 ICON "notepadqq.ico"

1 24 "notepadqq.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,0,0
 PRODUCTVERSION 2,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Notepadqq"
            VALUE "FileDescription", "Notepadqq - text editor for developers"
            VALUE "FileVersion", "2.2.0.0"
            VALUE "InternalName", "notepadqq"
            VALUE "LegalCopyright", "GNU General Public License v3"
            VALUE "OriginalFilename", "notepadqq.exe"
            VALUE "ProductName", "Notepadqq"
            VALUE "ProductVersion", "2.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
